{
  "name": "lecture-hall-aq-monitor",
  "version": "1.0.0",
  "description": "Real-time air quality monitor for lecture halls using government environmental data (CPCB/SAFAR via OpenAQ)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx serve public -l 3000",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --watch --test tests/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "serve": "^14.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}